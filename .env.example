# ── Cloud SQL for PostgreSQL ──────────────────────────────────────────────────
# The VM reaches the instance over private IP via VPC peering; there is no
# public address on the database.
DATABASE_URL=postgresql://botuser:password@10.0.0.3:5432/whatsapp_bot

# ── Gemini (via Vertex AI) ────────────────────────────────────────────────────
# No API key: the bot calls Vertex AI as the VM's service account, which needs
# the Vertex AI User role (roles/aiplatform.user).
GOOGLE_CLOUD_PROJECT=prj-lta-sandbox-prd-ext-00428
GOOGLE_CLOUD_LOCATION=global
# Optional overrides. FAST parses every post; SMART writes /ask's SQL and lays
# out long answers.
# GEMINI_FAST_MODEL=gemini-2.5-flash
# GEMINI_SMART_MODEL=gemini-2.5-flash

# ── Baileys bridge ────────────────────────────────────────────────────────────
# The bridge is the ONLY transport: the bot serves WhatsApp groups, which the
# Meta Cloud API cannot carry. Both values are required — with nothing else to
# fall back to, an empty one means the bot can neither receive nor reply, so it
# refuses to start rather than failing silently later.
BAILEYS_BRIDGE_URL=http://bridge:8088
BRIDGE_SHARED_SECRET=must_match_the_bridge_BRIDGE_SHARED_SECRET

# ── Tunnel groups ─────────────────────────────────────────────────────────────
# One group per contract, each sending the standard TUNNEL PROGRESS UPDATE
# (CONTRACT / DATE / DRIVE / PROGRESS / TBM LOCATION / INSTRUMENTATION /
# ISSUES). Any line with a "!" is a flag for /!!. Comma-separated JIDs.
#
# These route to tunnel_progress / tunnel_flags and their /ask sees only their
# own rows; every other allowlisted group keeps the daily_logs behaviour.
# Each JID listed here must ALSO be in the bridge's ALLOWED_GROUP_IDS, or the
# message never reaches this service at all.
#
# Empty means no group is a tunnel group. That is deliberate: unlike the bridge
# allowlist this fails CLOSED, because the wrong default is to start filing
# tunnel updates as site logs.
TUNNEL_GROUP_IDS=

# ── Master group ──────────────────────────────────────────────────────────────
# The senior group director and the bot. /!! lists the day's "!" items from
# every tunnel group, grouped by contract; any other message is answered as a
# question across every contract. Nothing said here is filed. Comma-separated
# JIDs; must also be in the bridge's ALLOWED_GROUP_IDS. Empty = no master group.
MASTER_GROUP_IDS=
