WHATSAPP_TOKEN=your_whatsapp_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WEBHOOK_VERIFY_TOKEN=make_up_any_random_string
APP_SECRET=your_meta_app_secret

# ── Cloud SQL for PostgreSQL ──────────────────────────────────────────────────
# No host/port: the Cloud SQL Python Connector addresses the instance by name.
INSTANCE_CONNECTION_NAME=your-project:asia-southeast1:site-bot-db
DB_NAME=sitebot
# With IAM auth, DB_USER is the service-account email WITHOUT the
# ".gserviceaccount.com" suffix, and DB_PASSWORD stays empty.
DB_USER=site-bot-sa@your-project.iam
DB_PASSWORD=
DB_IAM_AUTH=true
DB_PRIVATE_IP=false

# ── Claude via Vertex AI ──────────────────────────────────────────────────────
# Auth is Application Default Credentials (the VM service account) — no key.
VERTEX_PROJECT_ID=your-project
VERTEX_REGION=global
PARSER_MODEL=claude-haiku-4-5@20251001
ANSWER_MODEL=claude-sonnet-4-6

# ── Baileys bridge (group messaging via unofficial WhatsApp Web) ──────────────
BAILEYS_BRIDGE_URL=http://bridge:8088
BRIDGE_SHARED_SECRET=must_match_the_bridge_BRIDGE_SHARED_SECRET
# Only accept logs from these group JIDs (comma-separated).
ALLOWED_GROUP_IDS=1203630xxxxxxxxxx@g.us
