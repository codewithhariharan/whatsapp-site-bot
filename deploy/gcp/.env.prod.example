# Production values that DIFFER from .env.example. Copy .env.example first,
# then override these.

# Service-to-service over the compose network — not localhost, not a public URL.
BAILEYS_BRIDGE_URL=http://bridge:8088

# The CR106 LTA PJT (Site Work) group JID. Read it from the bridge's first-boot
# log; see README.md → "Getting the group JID".
ALLOWED_GROUP_IDS=1203630xxxxxxxxxx@g.us
