PORT=8088
AUTH_DIR=/app/auth_info

# Service-to-service over the compose network.
PYTHON_INGEST_URL=http://api:8000/baileys/incoming

# Must match BRIDGE_SHARED_SECRET in the API's .env.
BRIDGE_SHARED_SECRET=generate_with_openssl_rand_hex_32

# Only forward messages from this group. The bridge will not start without
# ALLOWED_GROUP_IDS or ALLOWED_GROUP_NAMES set.
ALLOWED_GROUP_IDS=1203630xxxxxxxxxx@g.us

# Optional: link by pairing code instead of QR (digits only, with country code).
# PAIRING_NUMBER=6591234567
LOG_LEVEL=info
