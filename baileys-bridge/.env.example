# Where this bridge POSTs incoming group messages (the Python bot's ingest route).
# On the compose network the API is reachable by service name.
PYTHON_INGEST_URL=http://api:8000/baileys/incoming

# Shared secret authenticating BOTH directions (bridge <-> Python).
# Must match BRIDGE_SHARED_SECRET in the Python service's .env. Use a long random string.
BRIDGE_SHARED_SECRET=make_up_a_long_random_string

# ── Group allowlist (REQUIRED) ────────────────────────────────────────────────
# Without one of these the bridge forwards EVERY group the linked account
# belongs to. It refuses to start rather than run unfiltered.
#
# Prefer ALLOWED_GROUP_IDS — JIDs are stable. ALLOWED_GROUP_NAMES matches the
# group subject instead, which is convenient but breaks the moment anyone
# renames the group, and two groups can share a name. On this account several
# groups are called "CR106 ...", so the name match is genuinely ambiguous.
#
# On first boot the bridge logs every group it can see:
#   docker compose logs bridge | grep '"msg":"group"'
ALLOWED_GROUP_IDS=1203630xxxxxxxxxx@g.us
ALLOWED_GROUP_NAMES=

# Port the bridge's HTTP server listens on (Python calls /send and /send-document here).
PORT=8088

# Folder where the WhatsApp Web session is stored. Persist this across restarts
# (a named volume or a disk mount) so you don't re-link the device every deploy.
AUTH_DIR=./auth_info

# Link via an 8-char pairing code instead of a QR scan. Set to the bot's phone
# number with country code, digits only (no +, spaces or dashes). Leave blank
# to use QR instead. Example for India +91 98765 43210 -> 919876543210
PAIRING_NUMBER=

# pino log level: trace | debug | info | warn | error | silent
# Dropped messages (non-allowlisted groups, duplicate deliveries) log at debug.
LOG_LEVEL=info
