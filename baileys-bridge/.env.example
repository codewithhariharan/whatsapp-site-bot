# Where this bridge POSTs incoming group messages (your Python bot's ingest route).
# Local:  http://localhost:8000/baileys/incoming
# Railway: https://your-python-bot.up.railway.app/baileys/incoming
PYTHON_INGEST_URL=http://localhost:8000/baileys/incoming

# Shared secret authenticating BOTH directions (bridge <-> Python).
# Must match BRIDGE_SHARED_SECRET in the Python service's .env. Use a long random string.
BRIDGE_SHARED_SECRET=make_up_a_long_random_string

# Port the bridge's HTTP server listens on (Python calls /send and /send-document here).
PORT=8088

# Folder where the WhatsApp Web session is stored. Persist this across restarts
# (a Railway volume) so you don't re-scan the QR every deploy.
AUTH_DIR=./auth_info

# Link via an 8-char pairing code instead of a QR scan. Set to the bot's phone
# number with country code, digits only (no +, spaces or dashes). Leave blank
# to use QR instead. Example for India +91 98765 43210 -> 919876543210
PAIRING_NUMBER=

# The ONLY group the bot serves, matched on the group's name (case- and
# whitespace-insensitive). Messages from every other group are dropped here and
# never reach the Python bot. Must match ALLOWED_GROUP_NAME in the Python .env.
# Set to an empty string to serve every group the bot phone is in.
ALLOWED_GROUP_NAME=CR106 LTA PJT (Site Work)

# pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info
